# Copy to .env.local and fill in from your Supabase project (Project Settings → API).
# Without these, accounts and records are kept on each phone only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the link the 친구 초대 button shares (defaults to the address the app runs at).
VITE_INVITE_URL=
